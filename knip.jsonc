{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // A type or interface that names part of an exported signature stays exported so a caller can name it too.
  "ignoreExportsUsedInFile": { "interface": true, "type": true },
  // Packages declare their layer's workspace dependencies ahead of using them (render-ship, sim-hull and sim-rig are
  // still empty), and .dependency-cruiser.cjs already polices which edges may exist.
  "rules": { "dependencies": "off" },
  "workspaces": {
    ".": { "entry": ["scripts/*.js"] },
    "packages/tool-validate": {
      // The CLI that `pnpm validate` runs, the explicit benchmark list, and the browser page that run-browsers.ts
      // hands to Vite by URL rather than by import.
      "entry": ["src/cli.ts", "src/benchmarks/index.ts", "src/engines/page.ts"],
    },
    "packages/tool-scenario": {
      // Step 2 scaffolding (ADR 0003): the keyboard driver lands before the page binds keys to it.
      "entry": ["src/lib/host/keyboard.ts"],
    },
  },
}
