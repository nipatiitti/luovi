{
  "name": "luovi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "pnpm --filter @luovi/tool-scenario sync && tsc -b && pnpm --filter @luovi/tool-scenario check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "boundaries": "depcruise packages --config .dependency-cruiser.cjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm boundaries",
    "validate": "pnpm --filter @luovi/tool-scenario sync && tsc -b && node packages/tool-validate/dist/cli.js",
    "shots": "pnpm --filter @luovi/tool-scenario shots"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@webgpu/types": "^0.1.74",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
