+export const hexWgsl = /* wgsl */ `
+struct HexTaps {
+  offset0: vec2f,
+  offset1: vec2f,
+  offset2: vec2f,
+  // Barycentric weights over the root of their square sum: a linear field blends with these, a variance with their squares.
